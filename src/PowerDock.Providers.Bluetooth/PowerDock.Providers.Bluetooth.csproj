<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinRT 蓝牙投影只在 Windows 目标框架可用；Core 保持 net10.0 以便单测，故真实后端单独成项目。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>PowerDock.Providers.Bluetooth</AssemblyName>
    <RootNamespace>PowerDock.Providers.Bluetooth</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerDock.Core\PowerDock.Core.csproj" />
  </ItemGroup>

</Project>
