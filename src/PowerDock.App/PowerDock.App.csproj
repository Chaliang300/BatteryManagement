<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 需要 WinRT 蓝牙投影（Windows.Devices.Bluetooth），故对齐到 Windows 10 19041 目标框架；
         WPF 与 WinForms 在该 TFM 下仍完整可用。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- 托盘 NotifyIcon 与旧版 System.Drawing 位图绘制仍走 WinForms 控件集 -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PowerDock</AssemblyName>
    <RootNamespace>PowerDock.App</RootNamespace>
    <ApplicationManifest>..\..\app.manifest</ApplicationManifest>
    <StartupObject>PowerDock.App.Program</StartupObject>
    <!-- 保持 .NET Framework 时期源码命名空间不变：关闭隐式 using 与可空引用类型推断 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Product>PowerDock</Product>
    <Company>PowerDock</Company>
    <Copyright>MIT License</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerDock.Core\PowerDock.Core.csproj" />
    <!-- 真实蓝牙后端用 WinRT 投影，必须单独成 -windows 目标框架项目；App 负责注入。 -->
    <ProjectReference Include="..\PowerDock.Providers.Bluetooth\PowerDock.Providers.Bluetooth.csproj" />
  </ItemGroup>

</Project>
